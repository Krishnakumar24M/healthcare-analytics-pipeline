{
  "family": "healthcare-risk-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::306451251863:role/ecsTaskExecutionRole",

  "containerDefinitions": [
    {
      "name": "healthcare-streamlit-app",
      "image": "306451251863.dkr.ecr.us-east-1.amazonaws.com/healthcare-risk-app:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8501,
          "hostPort": 8501,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "STREAMLIT_SERVER_PORT", "value": "8501" },
        { "name": "STREAMLIT_SERVER_ADDRESS", "value": "0.0.0.0" },
        { "name": "AWS_DEFAULT_REGION", "value": "us-east-1" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/healthcare-risk-app",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}
